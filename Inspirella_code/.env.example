# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-only secret. Set it in your local .env or in the deployment
# platform's environment/secrets configuration. Never commit a real value.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configurations
SUPABASE_PROJECT_ID=""
SUPABASE_ANON_KEY=""
SUPABASE_ACCESS_TOKEN=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Mapbox Configurations
MAPBOX_ACCESS_TOKEN=""
MAPBOX_STYLE_URL=""

